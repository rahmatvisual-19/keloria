# ==============================================================================
# Konfigurasi Lingkungan Kelo-ERP (UMKM Keloria)
# Salin file ini menjadi .env.local (untuk Next.js) dan .env (untuk Prisma CLI)
# ==============================================================================

# Database PostgreSQL (lokal via Docker Compose atau cloud seperti Neon/Supabase)
DATABASE_URL="postgresql://kelo_user:kelo_password@localhost:5432/kelo_erp?schema=public"

# Autentikasi JWT (WAJIB diganti dengan string acak minimal 32 karakter di produksi)
JWT_SECRET="ganti-dengan-secret-acak-minimal-32-karakter-untuk-produksi"
JWT_EXPIRES_IN="8h"
COOKIE_NAME="kelo_session"

# Pengaturan Cookie SameSite:
# - Gunakan "lax" untuk pengembangan lokal atau deployment satu domain
# - Gunakan "none" (dengan HTTPS/Secure) bila frontend & backend di domain berbeda
COOKIE_SAME_SITE="lax"

# Origin frontend yang diizinkan untuk CORS dan perlindungan CSRF (tanpa trailing slash)
# Contoh dev Next.js port 3000: http://localhost:3000
# Contoh jika API dijalankan di port 4000 dan client terpisah di 5173: http://localhost:5173
CLIENT_ORIGIN="http://localhost:3000"

# Base URL API untuk frontend (kosongkan jika satu origin dengan Next.js,
# atau isi http://localhost:4000 jika memisahkan server API di port 4000)
NEXT_PUBLIC_API_BASE_URL=""

# Penyimpanan bukti bayar (di luar folder public agar hanya bisa diakses via endpoint terautentikasi)
STORAGE_DRIVER="local"
UPLOAD_DIR="./storage/uploads"

# Logging (trace | debug | info | warn | error | silent)
LOG_LEVEL="info"

# Mode runtime
NODE_ENV="development"
