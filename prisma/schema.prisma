// Skema Basis Data Kelo-ERP (UMKM Keloria)
// Provider default PostgreSQL; tipe data dijaga portable ke MySQL.
// Semua nominal uang memakai Decimal(12, 2) dan penghapusan transaksi diblokir (onDelete: Restrict).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum EmploymentType {
  Tetap
  PKL
}

enum PayScheme {
  Bulanan
  Mingguan
}

enum UserStatus {
  Aktif
  Nonaktif
}

enum SessionStatus {
  Aktif
  Logout
  Kedaluwarsa
}

enum PayrollPaymentType {
  Gaji_Bulanan  @map("Gaji Bulanan")
  Upah_Mingguan @map("Upah Mingguan")
  Kasbon
}

enum CustomerType {
  B2C
  B2B
}

enum OrderChannel {
  Online
  PO_Besar @map("PO Besar")
}

enum PaymentScheme {
  DP_50
  FULL
}

enum OrderStatus {
  Menunggu_Pembayaran
  DP_Lunas
  Produksi
  Packing
  Karantina
  Siap_Kirim
  Dikirim
  Selesai
  Dibatalkan
}

enum PoStatus {
  Dipesan
  Diterima
  Selesai
}

enum InvoiceType {
  DP_50
  PELUNASAN
  FULL
}

enum PaymentStatus {
  Belum_Bayar
  DP_Terbayar
  Lunas
}

enum PaymentTermType {
  DP_50       @map("DP 50%")
  Pelunasan
  Bayar_Penuh @map("Bayar Penuh")
}

enum ExpenseCategory {
  Pembelian_Supplier @map("Pembelian Supplier")
  Ongkir
  Kemasan
  Operasional
  Lain
}

// ============================================================================
// 1. ACCESS MANAGEMENT & RBAC
// ============================================================================

model Role {
  role_id          Int              @id @default(autoincrement())
  role_name        String           @unique @db.VarChar(50)
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  users            User[]
  role_permissions RolePermission[]

  @@map("roles")
}

model Module {
  module_id        Int              @id @default(autoincrement())
  module_code      String           @unique @db.VarChar(30)
  module_name      String           @db.VarChar(100)
  role_permissions RolePermission[]

  @@map("modules")
}

model RolePermission {
  role_permission_id Int     @id @default(autoincrement())
  role_id            Int
  module_id          Int
  can_view           Boolean @default(false)
  can_create         Boolean @default(false)
  can_edit           Boolean @default(false)
  can_delete         Boolean @default(false)

  role   Role   @relation(fields: [role_id], references: [role_id], onDelete: Restrict)
  module Module @relation(fields: [module_id], references: [module_id], onDelete: Restrict)

  @@unique([role_id, module_id])
  @@index([role_id])
  @@index([module_id])
  @@map("role_permissions")
}

model User {
  user_id         Int            @id @default(autoincrement())
  role_id         Int
  full_name       String         @db.VarChar(120)
  phone           String?        @db.VarChar(30)
  employment_type EmploymentType
  pay_scheme      PayScheme
  base_salary     Decimal        @default(0) @db.Decimal(12, 2)
  username        String         @unique @db.VarChar(60)
  password_hash   String         @db.VarChar(255)
  status          UserStatus     @default(Aktif)
  last_login      DateTime?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  role                Role             @relation(fields: [role_id], references: [role_id], onDelete: Restrict)
  session_logs        SessionLog[]
  payrolls_received   Payroll[]        @relation("PayrollEmployee")
  payrolls_recorded   Payroll[]        @relation("PayrollRecorder")
  orders_created      Order[]
  order_status_logs   OrderStatusLog[]
  purchase_orders     PurchaseOrder[]
  payments_verified   InvoicePayment[]
  expenses_recorded   Expense[]

  @@index([role_id])
  @@index([status])
  @@map("users")
}

model SessionLog {
  session_id String        @id @db.VarChar(64)
  user_id    Int
  login_at   DateTime      @default(now())
  logout_at  DateTime?
  status     SessionStatus @default(Aktif)

  user User @relation(fields: [user_id], references: [user_id], onDelete: Restrict)

  @@index([user_id])
  @@index([status])
  @@index([login_at])
  @@map("session_logs")
}

// ============================================================================
// 2. HUMAN RESOURCES (PAYROLL)
// ============================================================================

model Payroll {
  payroll_id       Int                @id @default(autoincrement())
  user_id          Int
  recorded_by      Int
  payment_date     DateTime
  payment_type     PayrollPaymentType
  gross_amount     Decimal            @db.Decimal(12, 2)
  kasbon_deduction Decimal            @default(0) @db.Decimal(12, 2)
  net_amount       Decimal            @db.Decimal(12, 2)
  period_label     String?            @db.VarChar(60)
  notes            String?            @db.VarChar(500)
  created_at       DateTime           @default(now())

  employee User @relation("PayrollEmployee", fields: [user_id], references: [user_id], onDelete: Restrict)
  recorder User @relation("PayrollRecorder", fields: [recorded_by], references: [user_id], onDelete: Restrict)

  @@index([user_id])
  @@index([recorded_by])
  @@index([payment_date])
  @@index([period_label])
  @@map("payrolls")
}

// ============================================================================
// 3. SALES & MARKETING
// ============================================================================

model Customer {
  customer_id     Int          @id @default(autoincrement())
  customer_name   String       @db.VarChar(150)
  customer_type   CustomerType @default(B2C)
  default_phone   String?      @db.VarChar(30)
  default_address String?      @db.VarChar(500)
  is_active       Boolean      @default(true)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  orders Order[]

  @@index([customer_type])
  @@index([is_active])
  @@index([customer_name])
  @@map("customers")
}

model Product {
  product_id          Int      @id @default(autoincrement())
  sku_code            String   @unique @db.VarChar(50)
  product_name        String   @db.VarChar(150)
  variant_size        String?  @db.VarChar(60)
  category            String   @db.VarChar(80)
  unit                String   @db.VarChar(30)
  unit_price          Decimal  @db.Decimal(12, 2)
  stock_online        Int      @default(0)
  min_stock_threshold Int      @default(0)
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  bom_items   ProductBom[]
  order_items OrderItem[]

  @@index([category])
  @@index([is_active])
  @@index([stock_online])
  @@map("products")
}

model Order {
  order_id              Int           @id @default(autoincrement())
  order_number          String        @unique @db.VarChar(30)
  customer_id           Int
  created_by            Int
  order_date            DateTime      @default(now())
  order_channel         OrderChannel
  payment_scheme        PaymentScheme
  recipient_name        String        @db.VarChar(150)
  recipient_phone       String        @db.VarChar(30)
  shipping_address      String        @db.VarChar(500)
  shipping_cost         Decimal       @default(0) @db.Decimal(12, 2)
  total_amount          Decimal       @db.Decimal(12, 2)
  tracking_number       String?       @db.VarChar(100)
  quarantine_doc_number String?       @db.VarChar(100)
  order_status          OrderStatus   @default(Menunggu_Pembayaran)
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt

  customer        Customer         @relation(fields: [customer_id], references: [customer_id], onDelete: Restrict)
  creator         User             @relation(fields: [created_by], references: [user_id], onDelete: Restrict)
  items           OrderItem[]
  status_logs     OrderStatusLog[]
  purchase_orders PurchaseOrder[]
  invoices        Invoice[]

  @@index([customer_id])
  @@index([created_by])
  @@index([order_date])
  @@index([order_channel])
  @@index([order_status])
  @@map("orders")
}

model OrderItem {
  order_item_id       Int     @id @default(autoincrement())
  order_id            Int
  product_id          Int
  qty                 Int
  unit_price_snapshot Decimal @db.Decimal(12, 2)
  subtotal            Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [order_id], references: [order_id], onDelete: Restrict)
  product Product @relation(fields: [product_id], references: [product_id], onDelete: Restrict)

  @@index([order_id])
  @@index([product_id])
  @@map("order_items")
}

model OrderStatusLog {
  log_id      Int          @id @default(autoincrement())
  order_id    Int
  from_status OrderStatus?
  to_status   OrderStatus
  changed_by  Int
  changed_at  DateTime     @default(now())
  note        String?      @db.VarChar(500)

  order Order @relation(fields: [order_id], references: [order_id], onDelete: Restrict)
  actor User  @relation(fields: [changed_by], references: [user_id], onDelete: Restrict)

  @@index([order_id])
  @@index([changed_at])
  @@map("order_status_logs")
}

// ============================================================================
// 4. SUPPLY CHAIN MANAGEMENT (MATERIALS, BOM, SUPPLIERS, PO)
// ============================================================================

model Material {
  material_id   Int      @id @default(autoincrement())
  material_name String   @unique @db.VarChar(150)
  unit          String   @db.VarChar(30)
  default_cost  Decimal  @default(0) @db.Decimal(12, 2)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  bom_usages ProductBom[]
  po_items   PurchaseOrderItem[]

  @@index([is_active])
  @@map("materials")
}

model ProductBom {
  bom_id       Int     @id @default(autoincrement())
  product_id   Int
  material_id  Int
  qty_per_unit Decimal @db.Decimal(12, 4)

  product  Product  @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  material Material @relation(fields: [material_id], references: [material_id], onDelete: Restrict)

  @@unique([product_id, material_id])
  @@index([product_id])
  @@index([material_id])
  @@map("product_bom")
}

model Supplier {
  supplier_id    Int      @id @default(autoincrement())
  supplier_name  String   @unique @db.VarChar(150)
  contact_person String?  @db.VarChar(120)
  phone          String?  @db.VarChar(30)
  address        String?  @db.VarChar(500)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  purchase_orders PurchaseOrder[]

  @@index([is_active])
  @@map("suppliers")
}

model PurchaseOrder {
  po_id       Int      @id @default(autoincrement())
  po_number   String   @unique @db.VarChar(30)
  order_id    Int
  supplier_id Int
  created_by  Int
  po_date     DateTime @default(now())
  total_cost  Decimal  @db.Decimal(12, 2)
  po_status   PoStatus @default(Dipesan)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  order    Order               @relation(fields: [order_id], references: [order_id], onDelete: Restrict)
  supplier Supplier            @relation(fields: [supplier_id], references: [supplier_id], onDelete: Restrict)
  creator  User                @relation(fields: [created_by], references: [user_id], onDelete: Restrict)
  items    PurchaseOrderItem[]
  expense  Expense?

  @@index([order_id])
  @@index([supplier_id])
  @@index([po_date])
  @@index([po_status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  po_item_id    Int     @id @default(autoincrement())
  po_id         Int
  material_id   Int
  qty_ordered   Decimal @db.Decimal(12, 4)
  unit          String  @db.VarChar(30)
  package_cost  Decimal @db.Decimal(12, 2)
  subtotal_cost Decimal @db.Decimal(12, 2)

  purchase_order PurchaseOrder @relation(fields: [po_id], references: [po_id], onDelete: Restrict)
  material       Material      @relation(fields: [material_id], references: [material_id], onDelete: Restrict)

  @@index([po_id])
  @@index([material_id])
  @@map("purchase_order_items")
}

// ============================================================================
// 5. FINANCE & ACCOUNTING
// ============================================================================

model Invoice {
  invoice_id           Int           @id @default(autoincrement())
  invoice_number       String        @unique @db.VarChar(30)
  order_id             Int
  invoice_type         InvoiceType
  issued_date          DateTime      @default(now())
  total_billed         Decimal       @db.Decimal(12, 2)
  shipping_cost_billed Decimal       @default(0) @db.Decimal(12, 2)
  payment_status       PaymentStatus @default(Belum_Bayar)
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt

  order    Order            @relation(fields: [order_id], references: [order_id], onDelete: Restrict)
  payments InvoicePayment[]

  @@index([order_id])
  @@index([invoice_type])
  @@index([issued_date])
  @@index([payment_status])
  @@map("invoices")
}

model InvoicePayment {
  payment_id      Int             @id @default(autoincrement())
  invoice_id      Int
  verified_by     Int
  payment_date    DateTime        @default(now())
  term_type       PaymentTermType
  amount_paid     Decimal         @db.Decimal(12, 2)
  payment_method  String?         @db.VarChar(60)
  proof_file_path String?         @db.VarChar(255)
  proof_note      String?         @db.VarChar(500)
  created_at      DateTime        @default(now())

  invoice  Invoice @relation(fields: [invoice_id], references: [invoice_id], onDelete: Restrict)
  verifier User    @relation(fields: [verified_by], references: [user_id], onDelete: Restrict)

  @@index([invoice_id])
  @@index([verified_by])
  @@index([payment_date])
  @@map("invoice_payments")
}

model Expense {
  expense_id   Int             @id @default(autoincrement())
  po_id        Int?            @unique
  recorded_by  Int
  expense_date DateTime        @default(now())
  category     ExpenseCategory
  description  String          @db.VarChar(500)
  amount       Decimal         @db.Decimal(12, 2)
  created_at   DateTime        @default(now())

  purchase_order PurchaseOrder? @relation(fields: [po_id], references: [po_id], onDelete: Restrict)
  recorder       User           @relation(fields: [recorded_by], references: [user_id], onDelete: Restrict)

  @@index([recorded_by])
  @@index([expense_date])
  @@index([category])
  @@map("expenses")
}

// ============================================================================
// 6. PENOMORAN DOKUMEN OTOMATIS (ANTI RACE CONDITION)
// ============================================================================

model DocumentSequence {
  seq_key     String   @id @db.VarChar(30)
  last_number Int      @default(0)
  updated_at  DateTime @updatedAt

  @@map("document_sequences")
}
